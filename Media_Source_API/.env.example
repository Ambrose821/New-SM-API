# Media Source API - Environment Variables Example
# Copy to `.env` and fill in your values.

# ---- Server ----
PORT=3000
SESSION_SECRET=keyboard cat

# ---- Database ----
MONGO_URI=

# ---- Openverse API ----
# Client credentials for token fetch in openVerseAuth.ts
OPENVERSE_ID=
OPENVERSE_SECRET=

# ---- Pixabay API ----
# Used in pixaBayClient.ts
PIXPAY_API_KEY=

# ---- Gemini (Google GenAI) ----
# Used by GeminiLLMAgent in AIServices
GEMINI_API_KEY=

# ---- Media Editing Service ----
# If you externalize the URL instead of the default localhost
MEDIA_EDITOR_URL=

# ---- AWS Creds ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer `AWS_DEFAULT_REGION`; fallback to `AWS_REGION` if set
AWS_DEFAULT_REGION=us-east-1

# --- Graph Version
GRAPH_API_VERSION=23.0

# -- Media Editing --
MEDIA_EDITOR_URL=
RUNWARE_API_KEY=

MEDIA_INVESTIGATE_URL=
MEDIA_INVESTIGATE_KEY=


# -- Security
BASIC_DB_ENCRYPTION_KEY=


#Instagran auth
INSTAGRAM_REDIRECT_URI=

